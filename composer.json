{
	"name": "octfx/multipurge",
	"version": "2.0.0",
	"type": "mediawiki-extension",
	"description": "Purge multiple services like cloudflare and varnish on page modification",
	"homepage": "https://www.mediawiki.org/wiki/Extension:MultiPurge",
	"license": "GPL-2.0+",
	"authors": [
		{
			"name": "Hannes Kruse",
			"homepage": "https://octofox.de/",
			"role": "Developer"
		}
	],
	"require": {
		"ext-json": "*",
		"composer/installers": ">=1.0.1"
	},
	"require-dev": {
		"mediawiki/mediawiki-codesniffer": "52.0.0",
		"mediawiki/mediawiki-phan-config": "0.20.0",
		"mediawiki/minus-x": "2.0.1",
		"php-parallel-lint/php-console-highlighter": "1.0.0",
		"php-parallel-lint/php-parallel-lint": "1.4.0"
	},
	"scripts": {
		"test": [
			"parallel-lint . --exclude vendor --exclude node_modules",
			"@phpcs",
			"minus-x check ."
		],
		"fix": [
			"minus-x fix .",
			"phpcbf"
		],
		"phan": "phan -d . --long-progress-bar",
		"phpcs": "phpcs -sp --cache",
		"phpunit": "cd ../../ && composer phpunit -- extensions/MultiPurge/tests/phpunit/",
		"preflight": [
			"@test",
			"@phan",
			"@phpunit"
		]
	},
	"extra": {
		"installer-name": "MultiPurge"
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
